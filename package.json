{
  "name": "wa-premium-plus",
  "productName": "WA Premium Plus",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source WhatsApp desktop client with message scheduling and automation.",
  "license": "MIT",
  "author": "WA Premium Plus contributors",
  "homepage": "https://github.com/imbikramsaha/WA-Premium-Plus",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "node --no-warnings --test tests/*.test.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
